# OpenAI API Key (Required for embeddings and LLM response generation)
OPENAI_API_KEY=your_openai_api_key_here

# ── Primary LLM / Embedding Switch ─────────────────────────────────────────
# Set to 'true' to use OpenAI first (with Groq as automatic fallback on error).
# Set to 'false' to disable OpenAI completely and route ALL requests directly
# to the Groq fallback LLM / HuggingFace embedding model.
USE_PRIMARY_LLM=true
USE_PRIMARY_EMBEDDING=true

# Web Search API (Optional/Required for live Islamic fatwa/search — get free key at https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Redis Cache Settings (Optional — falls back to in-memory cache if not running)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Qdrant Vector Database Settings
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Reranker Settings (FlashRank - lightweight CPU cross-encoder)
RERANKER_ENABLED=true
RERANKER_SCORE_THRESHOLD=0.0

# LangSmith Observability (Optional — get free API key at https://smith.langchain.com)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=islamic-chatbot
